# TraceSeal environment template — copy to .env at REPO ROOT (gitignored).
# The Rust backend and the Node sidecar both load .env automatically.
# NEVER commit real values. NEVER put these in frontend/browser env vars.

# Hedera network: testnet | previewnet | mainnet
HEDERA_NETWORK=testnet

# Operator account (the account that pays tx fees and controls topic/token).
HEDERA_ACCOUNT_ID=0.0.11337423

# Private key — DER hex (ED25519 or ECDSA) or 0x-prefixed DER.
# Get it from the Hedera portal / your key generation step. Keep secret.
HEDERA_PRIVATE_KEY=

# Created via: node hedera/src/cli.mjs setup-topic
HEDERA_TOPIC_ID=0.0.11349560

# Created via: node hedera/src/cli.mjs setup-nft
HEDERA_NFT_TOKEN_ID=0.0.11349565

# Defaults to https://<network>.mirrornode.hedera.com — override only if needed.
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Optional: explicit sidecar path (auto-discovered otherwise).
# HEDERA_SIDECAR=/app/hedera/src/cli.mjs
